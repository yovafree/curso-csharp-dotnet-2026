@model MenuComida.Web.Models.PlatoViewModel;

<h1>Editar Plato</h1>

<a asp-action="Index" class="btn btn-secondary mb-3">Volver</a>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ImagenUrl" class="control-label"></label>
        <input asp-for="ImagenUrl" class="form-control" />
        <span asp-validation-for="ImagenUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Estado" class="control-label"></label>
        <select asp-for="Estado" class="form-control">
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="CategoriaId" class="control-label"></label>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
        <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias"></select>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>