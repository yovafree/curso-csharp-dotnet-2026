@model IEnumerable<MenuComida.Web.Models.CategoriaViewModel>;

<h1>Categorías de Platos</h1>

<a href="@Url.Action("Create", "Categorias")" class="btn btn-success mb-3">Crear Nueva Categoría</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td>
                    <a href="@Url.Action("Details", "Categorias", new { id = categoria.Id })" class="btn btn-primary">Ver</a>
                    <a href="@Url.Action("Edit", "Categorias", new { id = categoria.Id })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("Delete", "Categorias", new { id = categoria.Id })" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>