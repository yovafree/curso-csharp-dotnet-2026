@model MenuComida.Web.Models.CategoriaViewModel;

<h1>Crear Categoría</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" id="Nombre" name="Nombre" asp-for="Nombre" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        <textarea class="form-control" id="Descripcion" name="Descripcion" asp-for="Descripcion"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Crear</button>
</form>